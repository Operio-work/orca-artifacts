# Where your artifacts live (site/, dashboards/, state/). Default: ./library, else ./demo-library
ARTIFACTS_LIBRARY=./library
# Who is viewing: none | tailscale (Tailscale Serve headers) | header (any proxy)
ARTIFACTS_AUTH=none
# ARTIFACTS_USER_HEADER=x-forwarded-user
# ARTIFACTS_USER_NAME_HEADER=x-forwarded-preferred-username
# Saves from the app: folder | git (commit after 20 s of quiet)
ARTIFACTS_STORAGE=folder
# ARTIFACTS_GIT_PUSH=1
# Calendar days in dashboards (IANA zone); overrides the library config
# ARTIFACTS_TZ=America/New_York
