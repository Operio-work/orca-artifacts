# Where your artifacts live (site/, dashboards/, state/). Default: ./library, else ./demo-library
ARTIFACTS_LIBRARY=./library
# Who is viewing: none | tailscale (Tailscale Serve headers) | header (any proxy) | orca (signed in through ORCA)
ARTIFACTS_AUTH=none
# ARTIFACTS_USER_HEADER=x-forwarded-user
# ARTIFACTS_USER_NAME_HEADER=x-forwarded-preferred-username
# Saves from the app: folder | git (commit after 20 s of quiet)
ARTIFACTS_STORAGE=folder
# ARTIFACTS_GIT_PUSH=1
# Publishing from ORCA or scripts (POST /api/publish); 24+ characters, unset = off
# ARTIFACTS_PUBLISH_TOKEN=
# ARTIFACTS_PUBLISH_DIRECT=1   # let publishers skip approval
# Calendar days in dashboards (IANA zone); overrides the library config
# ARTIFACTS_TZ=America/New_York
# With ARTIFACTS_AUTH=orca: the shared secret (default: derived from the publish token) and your ORCA panel's URL
# ARTIFACTS_ORCA_SECRET=
# ARTIFACTS_ORCA_URL=https://orca.example.com
# Push alerts: contact for the push services; how often dashboard alerts are checked
# ARTIFACTS_VAPID_SUBJECT=mailto:you@example.com
# ARTIFACTS_ALERT_MINUTES=10
# Bigger requests (5 MB pages, shared photos). adapter-node's default is 512K
BODY_SIZE_LIMIT=8M
# Build time only: serve under a path (e.g. behind ORCA Host)
# ARTIFACTS_BASE=/c/acme/artifacts
