{
	"name": "orca-artifacts",
	"version": "0.1.0",
	"private": true,
	"description": "ORCA Artifacts: a self-hosted PWA that lists, organizes and renders your live pages and dashboards. Works alone or with ORCA.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/Operio-work/orca-artifacts.git"
	},
	"type": "module",
	"engines": {
		"node": ">=22.12"
	},
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev --port 5199",
		"build": "vite build",
		"start": "node build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest --run",
		"check:private": "node scripts/check-public.mjs"
	},
	"devDependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.2.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.76.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24.19.2",
		"bits-ui": "^2.20.0",
		"cn": "^0.5.2",
		"shadcn-svelte": "^1.8.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"svelte-sonner": "^1.2.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	}
}
